  "descansando":  { "text": "Descansando",          "problem": false, "icon": "moon" },
  "sem_ladainha": { "text": "Sem ladainha: parado", "problem": false, "icon": "dots" },
  "ladainha":     { "text": "Rezando a ladainha",   "problem": false, "icon": "diamond" },
  "travado":      { "text": "Travado",              "problem": true,  "icon": "cross" }
}
