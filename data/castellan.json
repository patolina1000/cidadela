{
  // Castelão (GDD, seção 20).
  // speed: células por segundo. A protagonista só corre (sem andar e sem botão de correr, 26/09/2026).
  //   1.8: meio-termo (decisão do Arthur, 30/09/2026: 1,267 ficou lenta e 2,4 rápida demais). O run-loop da v2 tem
  //   passada natural de 1,267 m/s (passada_m_s em assets/modelos/protagonista_v2/clipes/clipes.json): a animação toca na
  //   razão velocidade ÷ passada (1,8 → 1,42×), e os pés acompanham o chão sem deslizar. Teclas [ e ] do jogo (depuração
  //   temporária) mudam 0,1 cél/s jogando; o valor que o Arthur escolher vem para cá.
  // reach: alcance para construir e abrir máquinas, em células (centro a centro).
  // gatherReach: para coletar, distância máxima do centro do corpo até a borda do recurso;
  //   1.0 = precisa estar encostado, de lado ou na diagonal.
  // radius: raio do corpo para colisão, em células. 0.15 (era 0.3; decisão do Arthur, 29/09/2026: a hitbox estava
  //   grande demais): passa entre dois troncos com folga e entre pedras na diagonal; a coleta e o alcance contam do centro
  //   do corpo e não mudam com o raio.
  // gatherSurfaceReach: para coletar recurso que bloqueia um círculo (tronco, base da pedra ou do veio), distância
  //   máxima do centro do corpo até a borda do círculo. 1.3 = encostado de lado ou na diagonal da célula da árvore conta; duas células de distância, não.
  "speed": 1.8,
  "reach": 10.0,
  "gatherReach": 1.0,
  "radius": 0.15,
  "gatherSurfaceReach": 1.3,
  // handRecipes: o que só ela faz com as mãos, numa fila só; anda só com ela parada (andar pausa, não perde).
  //   purify (tecla P; docs/linha_energia.md): 2 fragmentos podres → 1 puro em 6 s, sem água.
  //   mold (tecla M; docs/linha_aldeoes.md): 2 argilas → 1 casca em 20 s, sem jarro, mas a até nearWater células (centro
  //   a centro) de uma célula de água; longe dela, espera.
  "handRecipes": {
    "purify": { "inputs": { "rotten_shard": 2 }, "outputs": { "pure_shard": 1 }, "seconds": 6 },
    "mold":   { "inputs": { "clay": 2 }, "outputs": { "shell": 1 }, "seconds": 20, "nearWater": 2 }
  },
  // digClay: clicar numa célula de margem encostada nela cava argila, 1 a cada 3 s; a margem não esgota (L1 do Arthur).
  "digClay": { "item": "clay", "seconds": 3 },
  // Aparência da protagonista v2 (docs/protagonista_v2_contrato.md, "CORES (provisórias, decididas na prévia, ficam em
  // data/)"), lida pela cena. shadowFloor: piso de sombra do toon só nela (contrato: ~0,5; o aldeão fica em 0,35).
  // rim: as partes que levam a borda de luz fria (data/visual.json): skin, cloth, hair, horn. Só o corpo (pele e roupa
  // íntima): decisão do Arthur, 30/09/2026, os filetes claros nas dobras do cabelo incomodavam.
  "looks": {
    "skin": "#91ADB7",
    "hair": "#4B5A69",
    "horn": "#2B2140",
    "cloth": "#3F3342",
    "shadowFloor": 0.5,
    "rim": ["skin", "cloth"]
  }
}
