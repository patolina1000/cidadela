{
  // Castelão (GDD, seção 20).
  // speed: células por segundo. A protagonista só corre (sem andar e sem botão de correr, 26/09/2026).
  //   2.4 = passada natural da animação run (2,421 m/s medido pelo Blender em
  //   assets/modelos/protagonista/protagonista.json), para os pés não deslizarem. Subir mais faz a
  //   animação tocar mais rápido (os pés acompanham).
  // reach: alcance para construir e abrir máquinas, em células (centro a centro).
  // gatherReach: para coletar, distância máxima do centro do corpo até a borda do recurso;
  //   1.0 = precisa estar encostado, de lado ou na diagonal.
  // radius: raio do corpo para colisão, em células.
  // gatherTrunkReach: para coletar recurso com tronco (árvore), distância máxima do centro do corpo até a superfície do
  //   tronco. 1.3 = encostado de lado ou na diagonal da célula da árvore conta; duas células de distância, não.
  "speed": 2.4,
  "reach": 10.0,
  "gatherReach": 1.0,
  "radius": 0.3,
  "gatherTrunkReach": 1.3
}
