{
  // Aldeões trabalhadores (GDD, seção 6). Velocidade por patamares (decisão de 29/09/2026):
  //   velocidade final = patamar × bônus do piso (construções com "speedBonus" em buildings.json) × penalidade,
  //   presa ao teto. A reprodução do clipe run acompanha a velocidade final, para os pés não deslizarem.
  // speedTiers: células por segundo; o primeiro é a base, os seguintes são as melhorias (por pesquisa ou era;
  //   o mecanismo fica para depois; hoje a tecla V do jogo alterna os patamares).
  // penaltySpeed: velocidade no patamar base com fome ou moral baixa (vira um multiplicador, 0,57 ÷ 0,8 =
  //   0,7125, aplicado a qualquer patamar; a tecla B do jogo liga a penalidade enquanto fome e moral não existem).
  // maxSpeed: teto da velocidade final.
  // gatherMultiplier: quanto mais devagar coletam que o Castelão (1.5 = 50% mais lento).
  // carry: quantos itens levam por viagem nas costas, pelo peso do item (docs/ladainhas.md): "pesado" é POR PONTO DE
  //   FORÇA (o aldeão nasce com Força 1); "leve" é fixo.
  // radius: raio do corpo, em células, para desviar dos troncos (o aldeão tem 0,40 m de altura).
  // resourceCellCost: custo extra de caminho para atravessar a célula de um recurso que só bloqueia um círculo
  //   (1 = uma célula a mais): preferem o chão aberto, mas passam sob a copa ou rente à pedra quando é mais curto.
  "speedTiers": [0.8, 1.0, 1.2],
  "penaltySpeed": 0.57,
  "maxSpeed": 1.5,
  "gatherMultiplier": 1.5,
  "carry": { "pesado": 1, "leve": 10 },
  // Ladainhas (docs/ladainhas.md). litanyLength: quantos comandos cabem por nível de Inteligência (1: 6; 2: 12).
  //   litanyRadius: raio do "mais perto" (colher, arrancar, cavar) em volta de onde o comando foi gravado, em células.
  //   agilityBonus: velocidade a mais por ponto de Agilidade acima de 1 (0.1 = +10%). Os três atributos nascem em 1.
  "litanyLength": [6, 12],
  "litanyRadius": 8,
  "agilityBonus": 0.1,
  "radius": 0.15,
  "resourceCellCost": 0.5
}
