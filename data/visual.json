{
  // Parâmetros de desenho que não são da simulação (lidos por src/View/VisualSettings.cs).
  // rim: borda de luz fria do Toon.gdshaderinc nos objetos de cenário (aprovada pelo Arthur, opção (b) do CENÁRIO).
  //   color: cor da borda (o sol frio do Main.tscn); strength: intensidade (emissão); width: acende onde
  //   |N·V| < width. 0,144 = a faixa da aproximação do CENÁRIO no Blender (Layer Weight "Facing" com blend 0,25
  //   dá 1 − |N·V|^0,5; o corte da rampa em 0,62 acende onde |N·V| < 0,38² = 0,144).
  //   scenery: se os objetos de cenário (árvores, pedras, veios) levam a borda. false (decisão do Arthur, 30/09/2026: os
  //   filetes claros nas pedras e veios incomodavam) desliga em todos, por cima do coldRim de assets/cenario/cenario.json
  //   (território do CENÁRIO, que continua listando os materiais de pedra e veio). Na protagonista, quem decide é
  //   looks.rim em data/castellan.json.
  "rim": { "color": "#B8C7E6", "strength": 0.1, "width": 0.144, "scenery": false },
  // occlusion: o que fica entre a câmera e a protagonista, num círculo em volta do peito dela, é recortado em
  //   pontilhado. radius: raio em metros; keep: fração dos pixels que ficam no miolo (a "opacidade");
  //   softness: fração do raio em que o recorte some aos poucos; chestHeight: altura do centro acima dos pés.
  "occlusion": { "radius": 0.6, "keep": 0.35, "softness": 0.3, "chestHeight": 0.45 },
  // villagerIcon: ícone de estado sobre a cabeça do aldeão (estados e textos em data/villager_status.json).
  //   height: altura da base do ícone acima dos pés (acima do cabelo: não tapa o rosto); worldSize: tamanho em metros
  //   quando cabe entre minPx e maxPx (pixels numa tela de referenceHeight de altura; fora disso, trava no limite).
  "villagerIcon": { "height": 0.62, "worldSize": 0.3, "minPx": 26, "maxPx": 44, "referenceHeight": 1890 },
  // resourcePick: clique e destaque sobre recursos (sem construção nem item na mão). Árvore: a copa conta a partir de
  //   canopyFrom metros (as do CENÁRIO começam em 1,06–1,09 m) e o tronco é um pilar do raio do tronco
  //   (data/resources.json) + trunkMargin (o tronco inclina até 12°). Pedra e veio: a caixa inteira do modelo.
  "resourcePick": { "canopyFrom": 1.0, "trunkMargin": 0.1 },
  // outline: contorno fino escuro do toon (GDD, seção 17; prova pedida pelo Arthur em 29/09/2026), em árvores, pedras,
  //   veios, aldeões, protagonista e construções. color: #1B1620 (o traço do rosto do aldeão); widthPx: espessura em
  //   pixels numa tela de referenceHeight de altura (fica igual em qualquer zoom); enabled: se começa ligado (a tecla O
  //   do jogo alterna). depthOffset: metros que a casca recua da câmera, para não furar camadas sobrepostas da mesma
  //   malha (as mechas do cabelo); na silhueta não muda nada.
  "outline": { "enabled": true, "color": "#1B1620", "widthPx": 1.5, "referenceHeight": 1890, "depthOffset": 0.03 }
}
