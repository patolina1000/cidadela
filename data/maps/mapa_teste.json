{
  // Mapa do marco 1: grade plana com alguns objetos de teste.
  // Coordenadas em células; x cresce para leste, z para sul.
  "width": 32,
  "height": 32,
  // Onde o Castelão nasce. Os atributos dele ficam em data/castellan.json.
  "castellan": { "x": 15, "z": 16 },
  "resources": [
    { "kind": "wood",  "x": 4,  "z": 5 },
    { "kind": "wood",  "x": 5,  "z": 5 },
    { "kind": "wood",  "x": 4,  "z": 6 },
    { "kind": "stone", "x": 26, "z": 4 },
    { "kind": "stone", "x": 27, "z": 5 },
    { "kind": "iron",  "x": 25, "z": 26 },
    { "kind": "iron",  "x": 26, "z": 26 }
  ],
  // Construções já presentes no início (tipos de data/buildings.json). direction: north, east, south, west.
  "buildings": [
    { "kind": "sawmill", "x": 12, "z": 14 },
    { "kind": "smelter", "x": 18, "z": 14 },
    { "kind": "forge",   "x": 18, "z": 18 }
  ],
  // Terreno (tipos de data/terrain.json): um padrão e manchas por cima, na ordem (a última vence).
  // Mancha com radius é um círculo em volta da célula; com width e height, um retângulo a partir dela.
  "terrain": {
    "default": "grass",
    "patches": [
      // Margem de rio a oeste, com a borda recortada, e lama perto dela.
      { "kind": "sand",  "x": 0,  "z": 0,  "width": 3, "height": 32 },
      { "kind": "sand",  "x": 3,  "z": 9,  "radius": 2.5 },
      { "kind": "sand",  "x": 2,  "z": 21, "radius": 3 },
      { "kind": "mud",   "x": 6,  "z": 26, "radius": 3 },
      // Pátio de terra batida da base.
      { "kind": "dirt",  "x": 15, "z": 16, "radius": 5.5 },
      { "kind": "dirt",  "x": 11, "z": 19, "radius": 2.5 },
      // Chão de pedra em volta das rochas e do veio de ferro.
      { "kind": "stone", "x": 26, "z": 4,  "radius": 3.5 },
      { "kind": "stone", "x": 25, "z": 26, "radius": 3 }
    ]
  }
  // Aguardando o novo aldeão: aqui ficavam os aldeões livres do início.
}
