  "crystal_mine": { "name": "Mina de Cristal", "cost": { "stone": 10, "wood": 5 }, "solid": true, "onResource": "rotten_shard",
                    "mana": { "use": 2 }, "posts": { "count": 1, "name": "Minerador", "tool": "pick" } },
  "well":       { "name": "Poço", "cost": { "stone": 10 },                          "solid": true, "nextToWater": true,
