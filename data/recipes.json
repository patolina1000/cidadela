  // inputs/outputs: itens por ciclo. seconds: duração de um ciclo.
  "shafts": { "machine": "sawmill", "inputs": { "wood": 1 },              "outputs": { "shaft": 2 }, "seconds": 2 },
  "ingot":  { "machine": "smelter", "inputs": { "iron": 2 },              "outputs": { "ingot": 1 }, "seconds": 3 },
  "sword":  { "machine": "forge",   "inputs": { "ingot": 2, "shaft": 1 }, "outputs": { "sword": 1 }, "seconds": 5 }
